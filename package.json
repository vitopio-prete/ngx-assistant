{
  "name": "ngx-assistant",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "lefthook install",
    "dev": "pnpm --filter @ngx-assistant/engine build && ng build @ngx-assistant/angular && ng serve demo",
    "build": "pnpm --filter @ngx-assistant/engine build && ng build @ngx-assistant/angular && ng build demo",
    "test": "pnpm --filter @ngx-assistant/engine test && pnpm --filter @ngx-assistant/engine build && ng test @ngx-assistant/angular --watch=false",
    "e2e": "pnpm --filter @ngx-assistant/demo e2e",
    "typecheck": "pnpm --filter @ngx-assistant/engine typecheck",
    "smoke": "pnpm --filter @ngx-assistant/engine smoke",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "pnpm audit --prod --audit-level high"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "assistant-stream": "^0.3.53",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@ngx-assistant/engine": "workspace:*",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "lefthook": "^2.2.2",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  }
}
