{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../../dist/angular/schematics",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "vitest.config.mts", "testing/**"]
}
